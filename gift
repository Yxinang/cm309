<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>309 歡樂遊樂場與獎品兌換</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti CDN (慶祝特效) -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;700&family=Noto+Sans+TC:wght@500;700&display=swap');
        body { font-family: 'Fredoka', 'Noto Sans TC', sans-serif; background-color: #f0fdf4; }
    </style>
</head>
<body class="min-h-0 text-gray-800 flex flex-col items-center p-4">

    <!-- 頂部導覽列 / 身分切換 -->
    <header class="w-full max-w-4xl bg-white shadow-md rounded-2xl p-4 mb-6 flex flex-wrap justify-between items-center border-4 border-emerald-300">
        <div class="flex items-center space-x-3 mb-2 sm:mb-0">
            <span class="text-3xl">🐱</span>
            <h1 class="text-2xl font-bold text-emerald-600">309 班級遊樂場與兌換</h1>
        </div>
        <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-2 bg-emerald-50 px-3 py-1.5 rounded-xl border-2 border-emerald-200">
                <label for="studentSelect" class="font-bold text-sm text-emerald-700">選擇學生：</label>
                <select id="studentSelect" onchange="switchStudent()" class="bg-white border border-emerald-300 rounded-lg px-2 py-1 font-bold text-emerald-800 focus:outline-none">
                    <!-- 動態載入學生 -->
                </select>
            </div>
            <div class="bg-amber-100 border-2 border-amber-300 px-3.5 py-1.5 rounded-xl flex items-center space-x-1 shadow-inner">
                <span class="text-xl">🪙</span>
                <span class="text-sm font-bold text-amber-800">代幣：</span>
                <span id="studentCoins" class="text-lg font-black text-amber-600">0</span>
            </div>
        </div>
    </header>

    <!-- 主要功能區塊 (標籤頁切換) -->
    <main class="w-full max-w-4xl bg-white shadow-xl rounded-3xl p-6 border-4 border-emerald-200">
        
        <!-- 導覽標籤 -->
        <div class="flex justify-center space-x-2 sm:space-x-4 mb-6 border-b-2 border-gray-100 pb-4">
            <button onclick="switchTab('gacha')" id="tab-gacha" class="tab-btn px-4 py-2.5 rounded-2xl font-bold text-base transition-all bg-emerald-500 text-white shadow-md">🎁 幸運扭蛋機</button>
            <button onclick="switchTab('ladder')" id="tab-ladder" class="tab-btn px-4 py-2.5 rounded-2xl font-bold text-base transition-all bg-gray-100 text-gray-600 hover:bg-emerald-100">🧗 爬梯子冒險</button>
            <button onclick="switchTab('battle')" id="tab-battle" class="tab-btn px-4 py-2.5 rounded-2xl font-bold text-base transition-all bg-gray-100 text-gray-600 hover:bg-emerald-100">⚔️ 數字比大小</button>
            <button onclick="switchTab('shop')" id="tab-shop" class="tab-btn px-4 py-2.5 rounded-2xl font-bold text-base transition-all bg-gray-100 text-gray-600 hover:bg-emerald-100">🛍️ 獎品兌換區</button>
        </div>

        <!-- 1. 扭蛋機畫面 -->
        <div id="section-gacha" class="tab-content text-center py-6">
            <h2 class="text-2xl font-bold text-emerald-700 mb-2">✨ 歡樂扭蛋機 ✨</h2>
            <p class="text-gray-500 mb-6">每次消耗 <span class="font-bold text-amber-600">10 代幣</span>，試試你的手氣抽大獎！</p>
            <div class="w-48 h-48 mx-auto bg-gradient-to-b from-pink-400 to-red-500 rounded-full flex items-center justify-center shadow-2xl border-8 border-white mb-6 relative animate-bounce">
                <span class="text-7xl">🔮</span>
            </div>
            <button onclick="playGacha()" class="bg-amber-400 hover:bg-amber-500 text-amber-950 font-black text-xl px-8 py-3 rounded-2xl shadow-lg border-b-4 border-amber-600 active:translate-y-1 transition-all">轉扭蛋 (-10代幣)</button>
            <div id="gachaResult" class="mt-6 text-xl font-bold text-emerald-600 h-10"></div>
        </div>

        <!-- 2. 爬梯子畫面 -->
        <div id="section-ladder" class="tab-content hidden text-center py-6">
            <h2 class="text-2xl font-bold text-emerald-700 mb-2">🧗 神秘爬梯子 🧗</h2>
            <p class="text-gray-500 mb-6">選擇一條幸運路線，看看通往哪個獎勵！(消耗 5 代幣)</p>
            <div class="flex justify-center space-x-4 mb-6">
                <button onclick="playLadder(1)" class="bg-blue-400 hover:bg-blue-500 text-white font-bold px-6 py-3 rounded-2xl shadow-md border-b-4 border-blue-600">路線 1</button>
                <button onclick="playLadder(2)" class="bg-purple-400 hover:bg-purple-500 text-white font-bold px-6 py-3 rounded-2xl shadow-md border-b-4 border-purple-600">路線 2</button>
                <button onclick="playLadder(3)" class="bg-pink-400 hover:bg-pink-500 text-white font-bold px-6 py-3 rounded-2xl shadow-md border-b-4 border-pink-600">路線 3</button>
            </div>
            <div id="ladderResult" class="mt-6 text-xl font-bold text-purple-600 h-16 flex items-center justify-center bg-purple-50 rounded-2xl border-2 border-purple-200 p-4">請點選上方任一條路線開始挑戰！</div>
        </div>

        <!-- 3. 比大小畫面 -->
        <div id="section-battle" class="tab-content hidden text-center py-6">
            <h2 class="text-2xl font-bold text-emerald-700 mb-2">⚔️ 幸運數字比大小 ⚔️</h2>
            <p class="text-gray-500 mb-6">與電腦對決！抽出的數字大於電腦即獲勝 (消耗 5 代幣，贏了拿 15 代幣！)</p>
            <div class="flex justify-center items-center space-x-8 mb-8">
                <div class="bg-emerald-50 border-4 border-emerald-300 rounded-2xl p-6 w-32 shadow-md">
                    <div class="text-sm font-bold text-emerald-700 mb-1">你的數字</div>
                    <div id="playerNum" class="text-4xl font-black text-emerald-600">?</div>
                </div>
                <span class="text-3xl font-black text-gray-400">VS</span>
                <div class="bg-rose-50 border-4 border-rose-300 rounded-2xl p-6 w-32 shadow-md">
                    <div class="text-sm font-bold text-rose-700 mb-1">電腦數字</div>
                    <div id="cpuNum" class="text-4xl font-black text-rose-600">?</div>
                </div>
            </div>
            <button onclick="playBattle()" class="bg-emerald-500 hover:bg-emerald-600 text-white font-black text-xl px-8 py-3 rounded-2xl shadow-lg border-b-4 border-emerald-700 active:translate-y-1 transition-all">開始比大小 (-5代幣)</button>
            <div id="battleResult" class="mt-6 text-xl font-bold text-emerald-600 h-10"></div>
        </div>

        <!-- 4. 獎品兌換畫面 -->
        <div id="section-shop" class="tab-content hidden py-6">
            <h2 class="text-2xl font-bold text-emerald-700 mb-2 text-center">🛍️ 獎品與兌換券商城 🛍️</h2>
            <p class="text-gray-500 mb-6 text-center">使用你的代幣兌換心儀的獎品！</p>
            <div id="shopList" class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                <!-- 動態載入商品 -->
            </div>
            
            <h3 class="text-xl font-bold text-emerald-700 mt-8 mb-4 border-t-2 pt-4">🎟️ 我已擁有的兌換券與獎品紀錄</h3>
            <div id="myCoupons" class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-2xl p-4 min-h-[100px] flex flex-wrap gap-2">
                <!-- 動態載入個人背包 -->
            </div>
        </div>

    </main>

    <!-- JavaScript 互動邏輯 -->
    <script>
        // 模擬 309 班級學生與資料結構 (可與 localStorage 串接)
        let students = JSON.parse(localStorage.getItem('cm309_students')) || [
            { id: 1, name: "1號 小明", coins: 50, coupons: [] },
            { id: 2, name: "2號 小華", coins: 40, coupons: [] },
            { id: 3, name: "3號 小美", coins: 60, coupons: [] },
            { id: 4, name: "4號 大寶", coins: 30, coupons: [] },
            { id: 5, name: "5號 貝貝", coins: 80, coupons: [] }
        ];

        let currentStudentId = students[0].id;

        // 獎品清單資料
        const shopItems = [
            { id: 1, name: "免寫作業卡 1 次", cost: 30, icon: "📝" },
            { id: 2, name: "換座位特權", cost: 50, icon: "🪑" },
            { id: 3, name: "精美小貼紙包", cost: 15, icon: "✨" },
            { id: 4, name: "神奇小餅乾", cost: 20, icon: "🍪" }
        ];

        // 初始化下拉選單與畫面
        function initApp() {
            const select = document.getElementById('studentSelect');
            select.innerHTML = '';
            students.forEach(s => {
                let opt = document.createElement('option');
                opt.value = s.id;
                opt.textContent = s.name;
                select.appendChild(opt);
            });
            updateView();
        }

        function getCurrentStudent() {
            return students.find(s => s.id == currentStudentId);
        }

        function switchStudent() {
            currentStudentId = document.getElementById('studentSelect').value;
            updateView();
        }

        function updateView() {
            let student = getCurrentStudent();
            document.getElementById('studentCoins').textContent = student.coins;
            renderShop();
            renderCoupons();
            localStorage.setItem('cm309_students', JSON.stringify(students));
        }

        // 標籤切換
        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('bg-emerald-500', 'text-white', 'shadow-md');
                el.classList.add('bg-gray-100', 'text-gray-600');
            });

            document.getElementById('section-' + tabName).classList.remove('hidden');
            let activeBtn = document.getElementById('tab-' + tabName);
            activeBtn.classList.remove('bg-gray-100', 'text-gray-600');
            activeBtn.classList.add('bg-emerald-500', 'text-white', 'shadow-md');
        }

        // 1. 扭蛋機邏輯
        function playGacha() {
            let student = getCurrentStudent();
            if (student.coins < 10) {
                alert('代幣不足喔！多去收集一些代幣再來吧！');
                return;
            }
            student.coins -= 10;
            
            const prizes = ["小貼紙一張", "20點代幣加碼！", "神奇小餅乾", "銘謝惠顧(安慰獎5代幣)"];
            let reward = prizes[Math.floor(Math.random() * prizes.length)];
            
            if(reward.includes("代幣加碼")) { student.coins += 20; }
            if(reward.includes("銘謝惠顧")) { student.coins += 5; }

            document.getElementById('gachaResult').innerHTML = `🎉 恭喜抽中了：<span class="text-amber-600">${reward}</span>！`;
            confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
            updateView();
        }

        // 2. 爬梯子邏輯
        function playLadder(pathNum) {
            let student = getCurrentStudent();
            if (student.coins < 5) {
                alert('代幣不足 5 枚！');
                return;
            }
            student.coins -= 5;

            const outcomes = [
                { text: "🌟 走對路！獲得 15 代幣！", coin: 15 },
                { text: "🎈 遇到微風吹拂，獲得 10 代幣！", coin: 10 },
                { text: "🍬 撿到掉落的小糖果，獲得 5 代幣！", coin: 5 }
            ];
            let result = outcomes[Math.floor(Math.random() * outcomes.length)];
            student.coins += result.coin;

            document.getElementById('ladderResult').innerHTML = `路線 ${pathNum} -> ${result.text}`;
            confetti({ particleCount: 80, spread: 60, origin: { y: 0.6 } });
            updateView();
        }

        // 3. 比大小邏輯
        function playBattle() {
            let student = getCurrentStudent();
            if (student.coins < 5) {
                alert('代幣不足 5 枚！');
                return;
            }
            student.coins -= 5;

            let pNum = Math.floor(Math.random() * 90) + 10;
            let cNum = Math.floor(Math.random() * 90) + 10;

            document.getElementById('playerNum').textContent = pNum;
            document.getElementById('cpuNum').textContent = cNum;

            let resText = "";
            if (pNum > cNum) {
                student.coins += 15;
                resText = "🎉 太棒了！你贏了，獲得 15 代幣！";
                confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
            } else if (pNum < cNum) {
                resText = "😢 可惡！電腦比較大，再接再厲！";
            } else {
                student.coins += 5;
                resText = "🤝 平手！退回本金 5 代幣！";
            }

            document.getElementById('battleResult').textContent = resText;
            updateView();
        }

        // 4. 獎品兌換渲染與邏輯
        function renderShop() {
            let container = document.getElementById('shopList');
            container.innerHTML = '';
            shopItems.forEach(item => {
                let div = document.createElement('div');
                div.className = "flex items-center justify-between p-4 bg-emerald-50 rounded-2xl border-2 border-emerald-200 shadow-sm";
                div.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <span class="text-3xl">${item.icon}</span>
                        <div>
                            <div class="font-bold text-gray-800">${item.name}</div>
                            <div class="text-sm text-amber-600 font-bold">需代幣：${item.cost}</div>
                        </div>
                    </div>
                    <button onclick="buyItem(${item.id})" class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-4 py-2 rounded-xl shadow">兌換</button>
                `;
                container.appendChild(div);
            });
        }

        function buyItem(itemId) {
            let student = getCurrentStudent();
            let item = shopItems.find(i => i.id == itemId);

            if (student.coins < item.cost) {
                alert('您的代幣不夠兌換這個獎品喔！');
                return;
            }

            student.coins -= item.cost;
            let serialCode = 'CM309-' + Math.random().toString(36).substring(2, 8).toUpperCase();
            student.coupons.push({ name: item.name, code: serialCode, date: new Date().toLocaleDateString() });

            alert(`成功兌換【${item.name}】！\n您的兌換序號為：${serialCode}`);
            confetti({ particleCount: 150, spread: 100, origin: { y: 0.5 } });
            updateView();
        }

        function renderCoupons() {
            let container = document.getElementById('myCoupons');
            let student = getCurrentStudent();
            container.innerHTML = '';

            if (student.coupons.length === 0) {
                container.innerHTML = '<span class="text-gray-400 text-sm">目前還沒有兌換券，快去玩遊戲賺代幣吧！</span>';
                return;
            }

            student.coupons.forEach(c => {
                let badge = document.createElement('div');
                badge.className = "bg-white border-2 border-amber-300 rounded-xl p-3 shadow-sm flex flex-col items-start";
                badge.innerHTML = `
                    <span class="font-bold text-emerald-700 text-sm">🎁 ${c.name}</span>
                    <span class="text-xs text-gray-500 font-mono mt-1">序號：${c.code}</span>
                    <span class="text-[10px] text-gray-400 mt-0.5">日期：${c.date}</span>
                `;
                container.appendChild(badge);
            });
        }

        // 啟動初始化
        initApp();
    </script>
</body>
</html>
